<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <!-- Android 16 Live Updates (promoted ongoing notification, status bar chip) -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS"/>

    <application>
        <!-- Keeps the app (Brew connection, audio, mic) running in the background
             and carries the ongoing notification. -->
        <service
            android:name="org.tetra.live.LiveService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback"/>

        <receiver android:name="org.tetra.live.PttReceiver" android:exported="false"/>

        <receiver
            android:name="org.tetra.live.StatusWidgetProvider"
            android:exported="true"
            android:label="@string/tetra_live_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/tetra_live_widget_info"/>
        </receiver>
    </application>
</manifest>
